# ==========================================
# GABARIT.AI - VARIÁVEIS DE AMBIENTE (EXEMPLO)
# Copie para .env e preencha. Dentro do compose os serviços se acessam pelo nome (rabbitmq, ...)
# ==========================================

# Mensageria (RabbitMQ)
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
# Portas publicadas no host (só docker-compose.override.yml / dev)
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Scraper
LOG_LEVEL=INFO
PCI_MCP_URL=https://mcp.pciconcursos.com.br/mcp
