{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gabarit.ai/contracts/events/extraction.failed.v1.json",
  "title": "extraction.failed v1",
  "description": "Um extraction.requested que não vai dar certo: entrada inválida (PDF ilegível, hash não confere, versão de prompt desconhecida, resultado fora do schema) ou erros transitórios em todas as tentativas. Publicado pelo extraction em gabarit.events com routing key extraction.failed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "version", "occurred_at", "correlation_id", "data"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "extraction.failed" },
    "version": { "const": 1 },
    "occurred_at": { "type": "string", "format": "date-time", "description": "UTC." },
    "correlation_id": { "type": ["string", "null"], "description": "message_id do extraction.requested." },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extraction_id", "task", "prompt_version", "reason", "retryable"],
      "properties": {
        "extraction_id": { "type": "string", "format": "uuid" },
        "task": { "type": "string", "minLength": 1 },
        "prompt_version": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1, "description": "Motivo legível (sem conteúdo do documento)." },
        "retryable": { "type": "boolean", "description": "true: falhou por erro transitório (API fora, limite de uso); pedir de novo mais tarde pode dar certo." }
      }
    }
  }
}
