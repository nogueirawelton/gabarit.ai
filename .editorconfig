# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,java,kt,xml,sql}]
indent_size = 4

[{Dockerfile,*.Dockerfile,Dockerfile.*}]
indent_size = 4

# Make exige tab
[{Makefile,*.mk}]
indent_style = tab
indent_size = 4

# Quebra de linha com dois espaços é significativa
[*.md]
trim_trailing_whitespace = false

# Scripts do Windows (ex.: mvnw.cmd do Maven wrapper)
[*.{cmd,bat,ps1}]
end_of_line = crlf
