# ==========================================
# GABARIT.AI - VARIÁVEIS DE AMBIENTE (EXEMPLO)
# ==========================================

# Banco de Dados (PostgreSQL)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Mensageria (RabbitMQ)
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_PORT=
RABBITMQ_MANAGEMENT_PORT=

# Storage (MinIO)
MINIO_USER=
MINIO_PASSWORD=
MINIO_PORT=
MINIO_MANAGEMENT_PORT=

# URLs de Conexão para os Workers (Python/Java)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DB}
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbitmq:${RABBITMQ_PORT}/
MINIO_URL=http://minio:${MINIO_PORT}