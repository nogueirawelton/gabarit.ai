{
  // Indentação, EOL e espaços finais vêm do .editorconfig
  "editor.formatOnSave": true,
  "editor.rulers": [100],

  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/target": true,
    "**/node_modules": true
  },

  // Python: Ruff formata e organiza imports; basedpyright cuida dos tipos
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "python.languageServer": "None",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,

  // Java
  "[java]": {
    "editor.defaultFormatter": "redhat.java"
  },
  "java.configuration.updateBuildConfiguration": "automatic",

  // YAML / compose
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[dockercompose]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },

  // Prettier para o que não é código do web; lê o .editorconfig por padrão
  "[json][jsonc][markdown][html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // Biome para o web (JS/TS/CSS só existem lá); config em web/biome.json
  "[javascript][typescript][javascriptreact][typescriptreact][css]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.organizeImports.biome": "explicit"
    }
  },

  // Makefile precisa de tab mesmo se o EditorConfig não carregar
  "[makefile]": {
    "editor.insertSpaces": false,
    "editor.detectIndentation": false
  }
}
