# ==========================================
# GABARIT.AI - VARIÁVEIS DE AMBIENTE (EXEMPLO)
# Dev: copie para .env e preencha (docker-compose.yml). Produção (Coolify, docker-compose.prod.yml):
# cadastre as mesmas variáveis na aba Environment Variables, com URLs públicas e segredos novos.
# Dentro do compose os serviços se acessam pelo nome (rabbitmq, keycloak, ...)
# ==========================================

# Banco (PostgreSQL + pgvector)
# superusuário: só para administração e scripts de init, nenhum serviço usa
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
# usuário do banco `core`, criado no primeiro boot (infra/postgres/init/01-core.sh)
CORE_DB_PASSWORD=
# Porta publicada no host (só dev; produção não publica portas)
POSTGRES_PORT=5432

# Core (Java)
# Porta publicada no host (só dev; produção não publica portas)
CORE_PORT=8080

# Autenticação (Keycloak)
KEYCLOAK_DB_PASSWORD=
# admin do console (http://localhost:8180/admin), criado no primeiro boot
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
# URL pública do Keycloak: issuer dos tokens e para onde o web redireciona no login
KEYCLOAK_URL=http://localhost:8180
# URL pública do web: para onde o Keycloak volta depois do login (realm) e origem liberada no CORS do core
WEB_URL=http://localhost:5173
# URL pública da API (core), usada pelo web
API_URL=http://localhost:8080
# E-mail do Keycloak (recuperar senha...) e do resumo diário de concursos do core (só produção:
# em dev o core manda para o Mailpit, http://localhost:8025). Vazio: ninguém envia e-mail
SMTP_HOST=
# 587 = STARTTLS; 465 = TLS direto (SMTP_SSL=true e SMTP_STARTTLS=false)
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_FROM=no-reply@gabarit.ai
SMTP_USER=
SMTP_PASSWORD=
# Portas publicadas no host (só dev; produção não publica portas)
KEYCLOAK_PORT=8180
WEB_PORT=5173
# caixa de e-mail de dev (Mailpit)
MAILPIT_PORT=8025

# Mensageria (RabbitMQ)
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
# Portas publicadas no host (só dev; produção não publica portas)
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Arquivos (MinIO, API S3). Senhas com 8+ caracteres
# root: só administração e o one-shot minio-init, nenhum serviço usa
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# usuário `core` do MinIO (bucket avatars), criado/atualizado pelo minio-init a cada subida
CORE_MINIO_PASSWORD=
# usuário `extraction` do MinIO (só lê documents/blobs/), criado/atualizado pelo minio-init
EXTRACTION_MINIO_PASSWORD=
# URL pública da API do MinIO: host das URLs pré-assinadas que o navegador usa
MINIO_PUBLIC_URL=http://localhost:9000
# Portas publicadas no host (só dev; produção não publica portas)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Scraper
LOG_LEVEL=INFO
PCI_BASE_URL=https://www.pciconcursos.com.br
# pausa entre requisições a qualquer fonte coletada (segundos), uma requisição por vez
SCRAPER_REQUEST_DELAY_S=1.0

# Extraction (worker da LLM). Chave só deste serviço; o core nunca a recebe
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# trava de segurança do core: pedidos novos à LLM por pessoa em 24 h (leitura que já existe não conta)
LLM_DAILY_LIMIT=150
