# ==========================================
# GABARIT.AI - VARIÁVEIS DE AMBIENTE (EXEMPLO)
# Copie para .env e preencha. Dentro do compose os serviços se acessam pelo nome (rabbitmq, ...)
# ==========================================

# Banco (PostgreSQL + pgvector)
# superusuário: só para administração e scripts de init, nenhum serviço usa
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
# usuário do banco `exam`, criado no primeiro boot (infra/postgres/init/01-exam.sh)
EXAM_DB_PASSWORD=
# Porta publicada no host (só docker-compose.override.yml / dev)
POSTGRES_PORT=5432

# Mensageria (RabbitMQ)
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
# Portas publicadas no host (só docker-compose.override.yml / dev)
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Scraper
LOG_LEVEL=INFO
PCI_MCP_URL=https://mcp.pciconcursos.com.br/mcp
